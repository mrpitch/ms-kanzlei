{
	"name": "ms-kanzlei",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "next build && next-export-optimize-images",
		"postbuild": "next-sitemap",
		"dev": "next dev",
		"start": "npx serve@latest out",
		"nuke": "rm -r node_modules; rm -r pnpm-lock.yaml; rm -rf .next; rm -r out",
		"format": "prettier --write .",
		"typecheck": "tsc --noEmit",
		"lint": "eslint",
